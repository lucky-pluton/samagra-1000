# ==============================================================================
# Samagra 1000 — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the root or set individual environment variables.
# ==============================================================================

# --- Server Configuration ---
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# --- Supabase Database & Auth (Backend API Service Role) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- Python Isolated Code Judge ---
PYTHON_PATH=C:\Users\Dell\.local\bin\python3.15.exe
JUDGE_TIMEOUT_MS=2000
JUDGE_MEMORY_LIMIT_MB=128

# Remote Judge0 Configuration (Optional)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_or_self_hosted_judge0_key

# --- Admin Authorization ---
ADMIN_EMAILS=admin@samagra.annam.ai,director@annam.ai
ADMIN_SECRET=samagra-admin-dev-secret

# --- Client Configuration ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME="Samagra 1000"
VITE_SAMAGRA_OFFICIAL_URL=https://samagra.annam.ai/
